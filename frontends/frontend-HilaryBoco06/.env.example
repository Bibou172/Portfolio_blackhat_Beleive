# Copier en .env.local pour le développement. En production (Vercel), définir ces variables
# dans Project Settings > Environment Variables (elles sont lues au moment du build).

# URL publique de l'API d'équipe (FastAPI), sans / final.
#   Développement : laisser vide -> http://localhost:8000
#   Production    : obligatoire, en HTTPS (ex. https://portfolio-api-equipe.vercel.app)
#   Si elle est absente en production, le site affiche directement les données de data/.
VITE_API_URL=

# Slug du candidat demandé à l'API (R1, R2, R8). Par défaut : celui de data/candidats/HilaryBoco06.json.
VITE_CANDIDAT_SLUG=hilary-boco
